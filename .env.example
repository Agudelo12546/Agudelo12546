# Copia este archivo a .env.local y completa los valores.
# En local salen de `pnpm exec supabase status -o env` (ver README).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas en el navegador ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para enlaces de correo).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
